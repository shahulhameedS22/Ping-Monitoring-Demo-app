# ==============================================================================
# Regional Ping Monitor - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Central Backend & Vercel Serverless Settings (Server-Side Only)
# ------------------------------------------------------------------------------
PORT=3000

# Authentication & Access Control
# In production (e.g. Vercel deployment), REQUIRE_AUTH defaults to true.
# In local development, you may set REQUIRE_AUTH=false for convenience.
REQUIRE_AUTH=true
CENTRAL_API_KEY="your-central-api-key-here"

# ------------------------------------------------------------------------------
# Regional Agent Endpoints (Server-Side Only - NEVER expose in VITE_ variables)
# ------------------------------------------------------------------------------
# IMPORTANT NETWORKING DIRECTIVE FOR VERCEL:
# 10.202.202.61 is an RFC 1918 private IPv4 address on the Test-In-dc02 Ubuntu VM.
# Vercel serverless functions cannot route directly to private 10.x.x.x addresses.
# Leave empty until a secure connection (e.g. Vercel Secure Compute, Tailscale,
# Cloudflare Tunnel, or HTTPS reverse proxy) is configured.
REGIONAL_IN_DC02_URL=""

# Remaining Regional Data Centers (Unconfigured by default until daemons are deployed)
REGIONAL_IN_DC01_URL=""
REGIONAL_LK_DC01_URL=""
REGIONAL_SG_DC01_URL=""

# Shared secret key passed to regional daemons (via Authorization / X-Regional-Auth)
REGIONAL_API_KEY=""

# ------------------------------------------------------------------------------
# Gemini API & Hosting
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional overrides if not using firebase-applet-config.json)
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
