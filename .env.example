# ==============================================================================
# Regional Ping Monitor - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Central Backend Server Settings (Node.js / Express - Server-Side Only)
# ------------------------------------------------------------------------------
PORT=3000

# Authentication & Access Control
# Set to "true" to require Authorization: Bearer <token> or X-API-Key on /api/* routes.
# Set to "false" during local development / testing.
REQUIRE_AUTH=false
CENTRAL_API_KEY="your-central-api-key-here"

# ------------------------------------------------------------------------------
# Regional Agent Endpoints (Server-Side Only - NEVER expose in VITE_ variables)
# ------------------------------------------------------------------------------
# Test VM: Test-In-dc02 (Ubuntu VM running Python Ping Daemon)
REGIONAL_IN_DC02_URL="http://10.202.202.61:8080"

# Remaining Regional Data Centers (Unconfigured by default until daemons are deployed)
REGIONAL_IN_DC01_URL=""
REGIONAL_LK_DC01_URL=""
REGIONAL_SG_DC01_URL=""

# Shared secret key passed to regional daemons (via Authorization / X-Regional-Auth)
REGIONAL_API_KEY=""

# ------------------------------------------------------------------------------
# Gemini API & Hosting
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional overrides if not using firebase-applet-config.json)
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
